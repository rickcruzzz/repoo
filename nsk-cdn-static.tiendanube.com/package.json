{
  "name": "@tiendanube/nube-sdk-register",
  "description": "Nube SDK web worker register",
  "version": "0.47.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:standard && npm run build:telemetry && npm run build:allow-unsafe-css && npm run build:allow-unsafe-css:telemetry",
    "build:standard": "tsup",
    "build:telemetry": "TELEMETRY_ENABLED=true tsup",
    "build:allow-unsafe-css": "ALLOW_UNSAFE_CSS=true tsup",
    "build:allow-unsafe-css:telemetry": "ALLOW_UNSAFE_CSS=true TELEMETRY_ENABLED=true tsup",
    "check": "biome check src/*",
    "check:fix": "biome check --write src/*",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@tiendanube/nube-sdk-internal-types": "*",
    "@vitest/ui": "^2.1.2",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "deepcopy": "^2.1.0"
  }
}
