# Copie para .env e adicione sua chave gratuita: https://www.pexels.com/api/
PEXELS_API_KEY=

# Opcional: somente números, com DDI e DDD. Ex.: 5511999999999
WHATSAPP_NUMBER=

# Opcional: e-mail que receberá os pedidos de orçamento.
CONTACT_EMAIL=

PORT=3100

# A ViaCEP usada no checkout não exige chave.
# Credenciais de pagamento devem ser adicionadas somente ao backend após a escolha do provedor.
